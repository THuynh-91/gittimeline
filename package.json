{
  "name": "gittimeline",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a public GitHub repository URL and watch its real Git history become a deterministic, rhythm-driven choreography.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:golden": "vitest run --update",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
